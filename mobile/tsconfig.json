{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "lib": ["dom", "es2015", "es2017", "es2020", "esnext"],
    "strict": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
